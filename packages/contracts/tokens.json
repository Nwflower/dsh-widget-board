{
  "font": {
    "family": "var(--dsw-font-family, ui-sans-serif, system-ui, sans-serif)"
  },
  "radius": {
    "card": "24px"
  },
  "color": {
    "bg": "var(--dsw-alias-bg-base)",
    "surface": "var(--dsw-alias-bg-layer-1)",
    "fg": "var(--dsw-alias-label-primary)",
    "muted": "var(--dsw-alias-label-tertiary)",
    "border": "var(--dsw-alias-border-l1)",
    "accent": "var(--dsw-alias-brand-primary)",
    "on-accent": "var(--dsw-alias-label-primary-inverted)"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "morph": "180ms",
    "morph-resize": "240ms",
    "digit": "500ms",
    "digit-stagger": "70ms",
    "sky-fade": "700ms",
    "drift": "16s",
    "rain": "800ms",
    "flash": "7s",
    "spin": "30s",
    "float": "4s",
    "drop": "1100ms",
    "press": "150ms",
    "ease-smooth": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-pop": "cubic-bezier(0.34, 1.45, 0.64, 1)",
    "ease-standard": "ease-in-out",
    "digit-distance": "8px",
    "digit-blur": "2px",
    "digit-dir-x": "0",
    "digit-dir-y": "1",
    "icon-scale": "0.25",
    "icon-blur": "2px",
    "text-shift": "4px",
    "text-blur": "2px",
    "drift-distance": "18px",
    "float-distance": "3px",
    "press-scale": "0.99",
    "thumb-scale": "0.95"
  }
}
