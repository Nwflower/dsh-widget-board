        "type": "number"
      }
    }
  },
  "actions": [
    {
      "id": "testv3.run",
      "label": {
        "zh": "跑一次",
        "en": "Run"
      }
    },
    {
      "id": "testv3.probe",
      "label": {
        "zh": "读订阅账本",
        "en": "Read the subscription ledger"
      }
    }
  ],
  "capabilities": [
    "testv3.echo",
    "widget-board:data.read",
    "testv3.gone"
  ]
