{
  "id": "board-hero",
  "title": {
    "zh": "看板题头",
    "en": "Board hero"
  },
  "description": {
    "zh": "一块活的看板的标题、说明与字模图案；像普通卡片一样拖动、缩放与移除。",
    "en": "The title, tagline and type specimen of a living board; drag, resize and remove it like any other card."
  },
  "author": "dsh-widget-board",
  "version": "0.1.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 2, "h": 18 },
  "minBox": { "w": 1, "h": 10 },
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "lead": { "type": "string", "maxLength": 20 },
      "accent": { "type": "string", "maxLength": 20 },
      "tail": { "type": "string", "maxLength": 20 },
      "tagline": { "type": "string", "maxLength": 80 }
    }
  },
  "text": {
    "props.lead.label": {
      "zh": "主句",
      "en": "Lead sentence"
    },
    "props.lead.hint": {
      "zh": "卡片上最大的一行",
      "en": "The largest line on the card"
    },
    "props.accent.label": {
      "zh": "强调词",
      "en": "Accent"
    },
    "props.accent.hint": {
      "zh": "主句里换一种颜色的词",
      "en": "The word in the lead that changes color"
    },
    "props.tail.label": {
      "zh": "补句",
      "en": "Tail"
    },
    "props.tagline.label": {
      "zh": "副句",
      "en": "Tagline"
    },
    "lead": {
      "zh": "一块",
      "en": "A"
    },
    "accent": {
      "zh": "活的",
      "en": "living"
    },
    "tail": {
      "zh": "看板",
      "en": "board"
    },
    "tagline": {
      "zh": "拖一拖，把常用的数据放在一页上",
      "en": "Drag to keep the numbers you check on one page"
    }
  }
}
