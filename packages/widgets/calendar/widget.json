{
  "id": "calendar",
  "title": {
    "zh": "月历",
    "en": "Calendar"
  },
  "description": {
    "zh": "一个月的日期网格，第二行写农历、节气与节日；有安排的日期带点，宽盒子里日程写成条目。可以翻到前后月份或回到今天。",
    "en": "A month grid whose second line carries the lunar date, solar terms and festivals; days with plans get a dot or, in a wide box, a bar with the title. Steps to the previous or next month or back to today."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 22 },
  "minBox": { "w": 1, "h": 10 },
  "scripts": ["vendor/lunar.js"],
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "weekStart": { "type": "string", "enum": ["mon", "sun"], "default": "mon" }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "events": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": ["date"],
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "title": { "type": "string", "maxLength": 120 },
            "tone": { "enum": ["accent", "warn", "danger"] }
          }
        }
      }
    }
  },
  "text": {
    "previous": {
      "zh": "上个月",
      "en": "Previous month"
    },
    "next": {
      "zh": "下个月",
      "en": "Next month"
    },
    "today": {
      "zh": "今天",
      "en": "Today"
    },
    "props.weekStart.label": {
      "zh": "一周从哪天起",
      "en": "Week starts on"
    },
    "props.weekStart.hint": {
      "zh": "周一起排是默认；周日起排把星期日放在第一列。",
      "en": "Monday by default; Sunday puts Sunday in the first column."
    }
  }
}
