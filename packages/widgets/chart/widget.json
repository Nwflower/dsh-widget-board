{
  "id": "chart",
  "title": {
    "zh": "图表",
    "en": "Chart"
  },
  "description": {
    "zh": "折线、面积与柱状三种趋势图，共用一份采样点；适合请求量、耗时与配额。",
    "en": "Line, area and bar trends over one set of samples; for traffic, latency and quotas."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 2, "h": 22 },
  "minBox": { "w": 1, "h": 14 },
  "source": "widget-board:usage.chart",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": { "enum": ["line", "area", "bar"] },
      "metric": { "type": "string", "enum": ["calls", "tokens"], "default": "calls" },
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "points": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "required": ["label", "value"],
          "properties": {
            "label": { "type": "string", "maxLength": 24 },
            "value": { "type": "number" }
          }
        }
      },
      "caption": { "type": "string", "maxLength": 160 }
    }
  },
  "text": {
    "props.kind.label": {
      "zh": "图表类型",
      "en": "Chart kind"
    },
    "props.kind.line": {
      "zh": "折线",
      "en": "Line"
    },
    "props.kind.area": {
      "zh": "面积",
      "en": "Area"
    },
    "props.kind.bar": {
      "zh": "柱状",
      "en": "Bar"
    },
    "props.metric.label": {
      "zh": "统计项",
      "en": "Metric"
    },
    "props.metric.calls": {
      "zh": "调用次数",
      "en": "Calls"
    },
    "props.metric.tokens": {
      "zh": "Token 用量",
      "en": "Tokens"
    },
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    },
    "empty": {
      "zh": "暂无采样点",
      "en": "No samples"
    }
  }
}
