{
  "id": "clock",
  "title": {
    "zh": "翻页时钟",
    "en": "Flip clock"
  },
  "description": {
    "zh": "时与分翻页的时钟，秒在右边走，日期与星期按当前语言显示。",
    "en": "A clock with flipping hours and minutes, running seconds alongside, and the date in the current language."
  },
  "author": "dsh-widget-board",
  "version": "0.1.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 14 },
  "minBox": { "w": 1, "h": 10 },
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "zone": { "type": "string", "maxLength": 40 },
      "showSeconds": { "type": "boolean" }
    }
  },
  "text": {
    "props.zone.label": {
      "zh": "时区",
      "en": "Time zone"
    },
    "props.zone.hint": {
      "zh": "IANA 名字，例如 Asia/Shanghai",
      "en": "An IANA name such as Asia/Shanghai"
    },
    "props.showSeconds.label": {
      "zh": "显示秒",
      "en": "Show seconds"
    },
    "zone": {
      "zh": "本地时间",
      "en": "Local time"
    },
    "invalidZoneShort": {
      "zh": "时区无效",
      "en": "Invalid zone"
    },
    "invalidZone": {
      "zh": "这个时区名读不出来，按本地时间显示",
      "en": "Unknown time zone; showing local time"
    }
  }
}
