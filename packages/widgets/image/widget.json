{
  "id": "image",
  "title": {
    "zh": "图片",
    "en": "Image"
  },
  "description": {
    "zh": "一张图加一行说明；图片用 data URL 或 blob URL，宿主沙箱只允许这两种来源。",
    "en": "An image with a caption; images arrive as data URLs or blob URLs, the only sources the sandbox allows."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "capabilities": ["widget-board:media.read"],
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 18 },
  "minBox": { "w": 1, "h": 12 },
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "localImage": { "type": "boolean", "title": "使用本地图片 / Use local image", "default": false },
      "focusX": { "type": "number", "minimum": 0, "maximum": 100, "default": 50, "title": "水平焦点 / Horizontal focus" },
      "focusY": { "type": "number", "minimum": 0, "maximum": 100, "default": 50, "title": "垂直焦点 / Vertical focus" }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "src": { "type": "string", "maxLength": 60000 },
      "alt": { "type": "string", "maxLength": 160 },
      "caption": { "type": "string", "maxLength": 160 }
    }
  },
  "text": {
    "props.focusX.label": { "zh": "水平焦点（%）", "en": "Horizontal focus (%)" },
    "props.focusY.label": { "zh": "垂直焦点（%）", "en": "Vertical focus (%)" },
    "data.alt.label": { "zh": "图片替代文字", "en": "Alternative text" },
    "data.caption.label": { "zh": "图片说明", "en": "Caption" },
    "empty": {
      "zh": "还没有图片",
      "en": "No image"
    }
  }
}
