{
  "id": "json",
  "title": {
    "zh": "JSON",
    "en": "JSON"
  },
  "description": {
    "zh": "一段 JSON 的树状查看器：对象与数组逐层折叠，值按类型着色，长文本直接换行。",
    "en": "A tree view of a JSON value: objects and arrays fold level by level, values are colored by type, and long text wraps."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 22 },
  "minBox": { "w": 1, "h": 10 },
  "source": "widget-board:board.json",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "value": {},
      "caption": { "type": "string", "maxLength": 160 }
    }
  },
  "text": {
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    }
  }
}
