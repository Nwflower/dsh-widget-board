{
  "id": "kv",
  "title": {
    "zh": "键值",
    "en": "Key-value"
  },
  "description": {
    "zh": "一组键值对，适合版本、主机、配置摘要与运行状态。",
    "en": "A set of key-value pairs for versions, hosts, config summaries and runtime state."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 18 },
  "minBox": { "w": 1, "h": 12 },
  "source": "widget-board:runtime.kv",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "columns": { "type": "integer", "minimum": 1, "maximum": 3 },
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "maxLength": 60 },
            "value": { "type": ["string", "number"] },
            "note": { "type": "string", "maxLength": 80 }
          }
        }
      }
    }
  },
  "text": {
    "props.columns.label": {
      "zh": "列数",
      "en": "Columns"
    },
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    },
    "empty": {
      "zh": "暂无字段",
      "en": "No fields"
    }
  }
}
