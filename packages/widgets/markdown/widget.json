{
  "id": "markdown",
  "title": {
    "zh": "Markdown",
    "en": "Markdown"
  },
  "description": {
    "zh": "Markdown 与代码卡：标题、列表、表格、引用和按语言高亮的代码块，适合笔记、提示词与片段。",
    "en": "Markdown and code: headings, lists, tables, quotes and language-highlighted code blocks for notes, prompts and snippets."
  },
  "author": "dsh-widget-board",
  "version": "0.1.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 2, "h": 22 },
  "minBox": { "w": 1, "h": 18 },
  "libs": ["marked", "highlight"],
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 60 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "markdown": { "type": "string", "maxLength": 60000 }
    }
  },
  "text": {
    "empty": {
      "zh": "还没有内容",
      "en": "Nothing here yet"
    },
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "眉题",
      "en": "Kicker"
    },
    "data.markdown.label": {
      "zh": "正文",
      "en": "Body"
    },
    "data.markdown.hint": {
      "zh": "Markdown 写法，表格与代码块都支持",
      "en": "Markdown; tables and fenced code are supported"
    }
  }
}
