{
  "id": "progress",
  "title": {
    "zh": "进度",
    "en": "Progress"
  },
  "description": {
    "zh": "一组带数值与说明的进度条，适合容量、配额与目标完成度。",
    "en": "A set of progress bars with values and notes; for capacity, quotas and goals."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 18 },
  "minBox": { "w": 1, "h": 12 },
  "source": "widget-board:capacity.items",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": ["label", "value", "max"],
          "properties": {
            "label": { "type": "string", "maxLength": 80 },
            "value": { "type": "number" },
            "max": { "type": "number" },
            "note": { "type": "string", "maxLength": 80 },
            "tone": { "enum": ["accent", "warn", "danger", "muted"] }
          }
        }
      }
    }
  },
  "text": {
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    },
    "empty": {
      "zh": "暂无进度",
      "en": "No metrics"
    }
  }
}
