{
  "id": "session-usage",
  "title": {
    "zh": "最近 Token 用量",
    "en": "Recent token usage"
  },
  "description": {
    "zh": "所选范围最近的 token 用量：总量、最近 30 次调用的走势、输入与输出等四项分项，以及最近一次调用。",
    "en": "Token usage for the selected window: the total, the trend across the last 30 calls, the four parts such as input and output, and the latest call."
  },
  "author": "dsh-widget-board",
  "version": "0.1.0",
  "sizes": [
    "m",
    "l"
  ],
  "source": "widget-board:session.usage",
  "refresh": {
    "mode": "interval",
    "everyMs": 10000
  },
  "defaultBox": {
    "w": 2,
    "h": 16
  },
  "minBox": {
    "w": 1,
    "h": 12
  },
  "scripts": [
    "view.js"
  ],
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "session",
          "today",
          "all"
        ],
        "default": "session"
      },
      "session": {
        "type": "string",
        "maxLength": 128
      }
    }
  },
  "data": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "available",
      "reason",
      "startedAt",
      "scope",
      "date",
      "session",
      "empty",
      "totals",
      "recent",
      "trend"
    ],
    "properties": {
      "available": {
        "type": "boolean"
      },
      "reason": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "sessions-unavailable",
          null
        ]
      },
      "startedAt": {
        "type": "number",
        "minimum": 0
      },
      "scope": {
        "type": "string",
        "enum": [
          "session",
          "today",
          "all"
        ]
      },
      "date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "session": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 8
      },
      "empty": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "no-sessions",
          "no-usage",
          null
        ]
      },
      "totals": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output",
              "cacheRead",
              "cacheWrite",
              "total",
              "calls",
              "estimated"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "minimum": 0
              },
              "calls": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "recent": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "session",
              "input",
              "output",
              "total",
              "estimated"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "session": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 8
              },
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "total": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "trend": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "value"
          ],
          "properties": {
            "at": {
              "type": "number",
              "minimum": 0
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "text": {
    "title": {
      "zh": "最近 Token 用量",
      "en": "Recent token usage"
    },
    "kickerSession": {
      "zh": "所选会话",
      "en": "Selected session"
    },
    "kickerToday": {
      "zh": "今天",
      "en": "Today"
    },
    "kickerAll": {
      "zh": "全部会话",
      "en": "All sessions"
    },
    "total": {
      "zh": "总量",
      "en": "Total"
    },
    "calls": {
      "zh": "{n} 次调用",
      "en": "{n} calls"
    },
    "estimated": {
      "zh": "含推算",
      "en": "includes estimates"
    },
    "estimatedCall": {
      "zh": "推算",
      "en": "estimated"
    },
    "estimatedNote": {
      "zh": "部分调用没有总数，总量按输入与输出推算",
      "en": "Some calls reported no total, so the total is estimated from input and output"
    },
    "input": {
      "zh": "输入",
      "en": "Input"
    },
    "output": {
      "zh": "输出",
      "en": "Output"
    },
    "cacheRead": {
      "zh": "缓存读",
      "en": "Cache read"
    },
    "cacheWrite": {
      "zh": "缓存写",
      "en": "Cache write"
    },
    "share": {
      "zh": "{pct}%",
      "en": "{pct}%"
    },
    "partAria": {
      "zh": "{label} {value} 个 token，占四项分项合计的 {pct}%",
      "en": "{label} {value} tokens, {pct}% of the four parts combined"
    },
    "trend": {
      "zh": "最近 {n} 次调用 · 自 {time} 起",
      "en": "Last {n} calls · since {time}"
    },
    "trendAria": {
      "zh": "用量走势：最近 {n} 次调用，最高 {high} 个 token，最新 {latest} 个 token",
      "en": "Usage trend: the last {n} calls, peak {high} tokens, latest {latest} tokens"
    },
    "totalAria": {
      "zh": "总量 {total} 个 token，{calls} 次调用",
      "en": "Total {total} tokens across {calls} calls"
    },
    "recent": {
      "zh": "最近一次调用",
      "en": "Latest call"
    },
    "sessionLabel": {
      "zh": "会话 {id}",
      "en": "Session {id}"
    },
    "loading": {
      "zh": "正在读取用量…",
      "en": "Reading usage…"
    },
    "unavailable": {
      "zh": "会话服务不可用，读不到用量",
      "en": "Sessions service unavailable, usage cannot be read"
    },
    "noSessions": {
      "zh": "还没有任何会话",
      "en": "No sessions yet"
    },
    "noUsage": {
      "zh": "所选范围还没有用量",
      "en": "No usage in this window"
    },
    "invalid": {
      "zh": "用量数据不完整",
      "en": "Incomplete usage data"
    },
    "previewKicker": {
      "zh": "示例数据",
      "en": "Sample data"
    },
    "props.scope.label": {
      "zh": "范围",
      "en": "Scope"
    },
    "props.scope.hint": {
      "zh": "统计哪一段时间的用量；今天与全部只覆盖看板插件启动之后的事件",
      "en": "Which window to count; today and all only cover events after the widget board plugin starts"
    },
    "props.scope.session": {
      "zh": "所选会话",
      "en": "Selected session"
    },
    "props.scope.today": {
      "zh": "今天",
      "en": "Today"
    },
    "props.scope.all": {
      "zh": "全部会话",
      "en": "All sessions"
    },
    "props.session.label": {
      "zh": "会话",
      "en": "Session"
    },
    "props.session.hint": {
      "zh": "留空时跟随最近一次有用量的会话；填上会话 id 就固定到那一个，最长 128 字符",
      "en": "Leave empty to follow the session that most recently reported usage; fill a session id to pin it, up to 128 characters"
    }
  }
}
