{
  "id": "stat",
  "title": {
    "zh": "数字",
    "en": "Stat"
  },
  "description": {
    "zh": "一个主数字、单位、趋势与一行说明，适合 KPI、额度和耗时。",
    "en": "A headline number with a unit, a trend and one line of context; for KPIs, quotas and elapsed time."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 16 },
  "minBox": { "w": 1, "h": 10 },
  "source": "widget-board:usage.stat",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "metric": { "type": "string", "enum": ["calls", "tokens"], "default": "calls" },
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "value": { "type": ["number", "string"] },
      "unit": { "type": "string", "maxLength": 16 },
      "delta": { "type": "number" },
      "note": { "type": "string", "maxLength": 80 },
      "caption": { "type": "string", "maxLength": 160 }
    }
  },
  "text": {
    "props.metric.label": {
      "zh": "统计项",
      "en": "Metric"
    },
    "props.metric.calls": {
      "zh": "调用次数",
      "en": "Calls"
    },
    "props.metric.tokens": {
      "zh": "Token 用量",
      "en": "Tokens"
    },
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    },
    "empty": {
      "zh": "暂无数据",
      "en": "No data"
    }
  }
}
