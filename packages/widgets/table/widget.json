{
  "id": "table",
  "title": {
    "zh": "表格",
    "en": "Table"
  },
  "description": {
    "zh": "几列紧凑表格：列名与对齐由 data 给出，行多时在卡片里滚动。",
    "en": "A compact table whose columns, alignment and rows come from data; it scrolls when rows grow."
  },
  "author": "dsh-widget-board",
  "version": "0.1.0",
  "sizes": ["s", "l"],
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kicker": { "type": "string", "maxLength": 40 },
      "title": { "type": "string", "maxLength": 80 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["key", "label"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "maxLength": 40 },
            "align": { "enum": ["left", "right"] }
          }
        }
      },
      "rows": {
        "type": "array",
        "maxItems": 200,
        "items": { "type": "object" }
      }
    }
  },
  "text": {
    "empty": {
      "zh": "暂无行",
      "en": "No rows"
    }
  }
}
