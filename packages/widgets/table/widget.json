{
  "id": "table",
  "title": {
    "zh": "表格",
    "en": "Table"
  },
  "description": {
    "zh": "几列紧凑表格：列名与对齐由 data 给出，行多时在卡片里滚动。",
    "en": "A compact table whose columns, alignment and rows come from data; it scrolls when rows grow."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 2, "h": 22 },
  "minBox": { "w": 1, "h": 14 },
  "source": "widget-board:providers.table",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "columns": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["key", "label"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "maxLength": 40 },
            "align": { "enum": ["left", "right"] }
          }
        }
      },
      "rows": {
        "type": "array",
        "maxItems": 200,
        "items": { "type": "object" }
      }
    }
  },
  "text": {
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "引题",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "附注",
      "en": "Meta"
    },
    "empty": {
      "zh": "暂无行",
      "en": "No rows"
    }
  }
}
