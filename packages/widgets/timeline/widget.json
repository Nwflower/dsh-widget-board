{
  "id": "timeline",
  "title": {
    "zh": "时间线",
    "en": "Timeline"
  },
  "description": {
    "zh": "按时间排的事件：时间、标题、细节与状态，适合提交、发布与事故记录。",
    "en": "Events in time order with time, title, detail and status; for commits, releases and incidents."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 18 },
  "minBox": { "w": 1, "h": 12 },
  "source": "widget-board:git.log",
  "props": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "cwd": { "type": "string", "maxLength": 260 },
      "title": { "type": "string", "maxLength": 80 },
      "kicker": { "type": "string", "maxLength": 40 },
      "meta": { "type": "string", "maxLength": 40 }
    }
  },
  "data": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": ["time", "title"],
          "properties": {
            "time": { "type": "string", "maxLength": 24 },
            "title": { "type": "string", "maxLength": 120 },
            "detail": { "type": "string", "maxLength": 160 },
            "status": { "enum": ["ok", "warn", "error", "idle"] }
          }
        }
      }
    }
  },
  "text": {
    "empty": {
      "zh": "暂无事件",
      "en": "No events"
    },
    "props.cwd.label": {
      "zh": "仓库路径",
      "en": "Repository path"
    },
    "props.cwd.hint": {
      "zh": "留空时跟随当前会话或工作区目录；填上路径就固定读那个仓库",
      "en": "Leave empty to follow the active session or workspace directory; fill a path to pin that repository"
    },
    "props.title.label": {
      "zh": "标题",
      "en": "Title"
    },
    "props.kicker.label": {
      "zh": "标签",
      "en": "Kicker"
    },
    "props.meta.label": {
      "zh": "说明",
      "en": "Meta"
    }
  }
}
