{
  "id": "weather",
  "title": {
    "zh": "天气",
    "en": "Weather"
  },
  "description": {
    "zh": "iOS 风格的天气卡：数据由 Open-Meteo 提供，组件把原始响应映射成五天预报；切换预报日时，天空背景、图标、温度与天气文字一起过渡。",
    "en": "An iOS-style weather card: Open-Meteo supplies the raw reading and the widget maps it into a five-day forecast; the living sky, icon, temperature and condition transition together as you switch days."
  },
  "author": "dsh-widget-board",
  "version": "0.2.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 22 },
  "minBox": { "w": 1, "h": 16 },
  "source": "http",
  "request": {
    "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,temperature_2m_mean&timezone=auto&forecast_days=5",
    "cacheMs": 18000000
  },
  "permissions": {
    "hosts": ["api.open-meteo.com"]
  },
  "props": {
    "type": "object",
    "properties": {
      "place": {
        "type": "object",
        "required": ["zh", "en"],
        "properties": {
          "zh": { "type": "string" },
          "en": { "type": "string" }
        },
        "default": { "zh": "北京", "en": "Beijing" }
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "default": 39.9042
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "default": 116.4074
      }
    }
  },
  "data": {
    "type": "object",
    "required": ["current", "daily"],
    "properties": {
      "timezone": { "type": "string" },
      "current": {
        "type": "object",
        "required": ["temperature_2m", "weather_code"],
        "properties": {
          "temperature_2m": { "type": "number" },
          "weather_code": { "type": "integer" }
        }
      },
      "daily": {
        "type": "object",
        "required": ["time", "weather_code", "temperature_2m_max", "temperature_2m_min", "temperature_2m_mean"],
        "properties": {
          "time": { "type": "array", "minItems": 5, "items": { "type": "string" } },
          "weather_code": { "type": "array", "minItems": 5, "items": { "type": "integer" } },
          "temperature_2m_max": { "type": "array", "minItems": 5, "items": { "type": "number" } },
          "temperature_2m_min": { "type": "array", "minItems": 5, "items": { "type": "number" } },
          "temperature_2m_mean": { "type": "array", "minItems": 5, "items": { "type": "number" } }
        }
      }
    }
  },
  "refresh": {
    "mode": "interval",
    "everyMs": 18000000
  },
  "text": {
    "loading": {
      "zh": "正在获取天气",
      "en": "Fetching weather"
    },
    "unavailable": {
      "zh": "暂时无法获取天气",
      "en": "Weather unavailable"
    }
  }
}
