{
  "id": "weather",
  "title": {
    "zh": "天气",
    "en": "Weather"
  },
  "description": {
    "zh": "窗景天气卡：数据由 Open-Meteo 提供，组件把原始响应映射成五天预报。背景是一幅现画的窗外景：晴有光晕、夜里有月亮与星，雨雪落在玻璃上顺着玻璃流；切换预报日时整片天空跟着换。",
    "en": "A window-view weather card: Open-Meteo supplies the raw reading and the widget maps it into a five-day forecast. The background is a painted view outside the window — sun glare, a moon and stars at night, rain and snow running down the glass — and switching days changes the whole sky."
  },
  "author": "dsh-widget-board",
  "version": "0.3.0",
  "sizes": ["s", "l"],
  "defaultBox": { "w": 1, "h": 22 },
  "minBox": { "w": 1, "h": 16 },
  "source": "http",
  "request": {
    "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,weather_code,is_day&daily=weather_code,temperature_2m_max,temperature_2m_min,temperature_2m_mean&timezone=auto&forecast_days=5",
    "cacheMs": 18000000
  },
  "permissions": {
    "hosts": ["api.open-meteo.com"]
  },
  "scripts": ["world.js", "glass.js"],
  "props": {
    "type": "object",
    "properties": {
      "place": {
        "type": "object",
        "required": ["zh", "en"],
        "properties": {
          "zh": { "type": "string" },
          "en": { "type": "string" }
        },
        "default": { "zh": "北京", "en": "Beijing" }
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "default": 39.9042
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "default": 116.4074
      }
    }
  },
  "data": {
    "type": "object",
    "required": ["current", "daily"],
    "properties": {
      "timezone": { "type": "string" },
      "current": {
        "type": "object",
        "required": ["temperature_2m", "weather_code"],
        "properties": {
          "temperature_2m": { "type": "number" },
          "weather_code": { "type": "integer" },
          "is_day": { "type": "integer" }
        }
      },
      "daily": {
        "type": "object",
        "required": ["time", "weather_code", "temperature_2m_max", "temperature_2m_min", "temperature_2m_mean"],
        "properties": {
          "time": { "type": "array", "minItems": 5, "items": { "type": "string" } },
          "weather_code": { "type": "array", "minItems": 5, "items": { "type": "integer" } },
          "temperature_2m_max": { "type": "array", "minItems": 5, "items": { "type": "number" } },
          "temperature_2m_min": { "type": "array", "minItems": 5, "items": { "type": "number" } },
          "temperature_2m_mean": { "type": "array", "minItems": 5, "items": { "type": "number" } }
        }
      }
    }
  },
  "refresh": {
    "mode": "interval",
    "everyMs": 18000000
  },
  "text": {
    "props.place.label": {
      "zh": "地点",
      "en": "Place"
    },
    "props.place.hint": {
      "zh": "显示在卡片上的地名",
      "en": "The place name shown on the card"
    },
    "props.latitude.label": {
      "zh": "纬度",
      "en": "Latitude"
    },
    "props.longitude.label": {
      "zh": "经度",
      "en": "Longitude"
    },
    "loading": {
      "zh": "正在获取天气",
      "en": "Fetching weather"
    },
    "unavailable": {
      "zh": "暂时无法获取天气",
      "en": "Weather unavailable"
    }
  }
}
