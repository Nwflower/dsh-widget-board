{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@dsh-widget-board/contracts/*": ["./packages/contracts/src/*"],
      "@dsh-widget-board/model/*": ["./packages/model/src/*"]
    }
  },
  "include": ["packages/host/src", "packages/model/src", "packages/contracts/src"]
}
